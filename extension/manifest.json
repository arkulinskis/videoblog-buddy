{
  "manifest_version": 3,
  "name": "VideoBlog Buddy Recorder",
  "short_name": "VideoBlog Buddy",
  "version": "1.1.0",
  "homepage_url": "https://videoblog-buddy.anvil.app/",
  "description": "One-click tab recording, click rings and auto-zoom on your clicks for VideoBlog Buddy.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VideoBlog Buddy",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabCapture", "storage", "activeTab", "tabs"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "commands": {
    "stop-recording": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Stop recording" },
    "pause-recording": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Pause or resume recording" },
    "add-marker": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "Add a chapter marker" },
    "draw": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Draw on the page" }
  }
}
